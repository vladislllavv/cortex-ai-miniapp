rules_version = '2';

// CortexAI Firestore Rules
// Приложение использует Telegram userId как идентификатор.
// Бот использует Firebase Client SDK без Auth.
// Данные защищены на уровне Telegram — только авторизованные пользователи
// получают доступ к Mini App через Telegram.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
